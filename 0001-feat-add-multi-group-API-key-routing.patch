new file mode 100644
index 000000000..ed580166b
--- /dev/null
+++ b/backend/migrations/246_api_key_routes.sql
@@ -0,0 +1,30 @@
+CREATE TABLE IF NOT EXISTS api_key_routes (
+    id BIGSERIAL PRIMARY KEY,
+    api_key_id BIGINT NOT NULL REFERENCES api_keys(id) ON DELETE CASCADE,
+    group_id BIGINT NOT NULL REFERENCES groups(id) ON DELETE CASCADE,
+    enabled BOOLEAN NOT NULL DEFAULT TRUE,
+    priority INTEGER NOT NULL DEFAULT 100,
+    weight INTEGER NOT NULL DEFAULT 1,
+    cooldown_seconds INTEGER NOT NULL DEFAULT 30,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    CONSTRAINT api_key_routes_priority_check CHECK (priority >= 0),
+    CONSTRAINT api_key_routes_weight_check CHECK (weight > 0),
+    CONSTRAINT api_key_routes_cooldown_check CHECK (cooldown_seconds >= 1),
+    CONSTRAINT api_key_routes_unique_key_group UNIQUE (api_key_id, group_id)
+);
+
+CREATE INDEX IF NOT EXISTS idx_api_key_routes_key_enabled_priority
+    ON api_key_routes (api_key_id, enabled, priority);
+
+CREATE INDEX IF NOT EXISTS idx_api_key_routes_group
+    ON api_key_routes (group_id);
+
+ALTER TABLE api_keys
+    ADD COLUMN IF NOT EXISTS multi_group_routing_enabled BOOLEAN NOT NULL DEFAULT FALSE;
+
+INSERT INTO api_key_routes (api_key_id, group_id, enabled, priority, weight, cooldown_seconds)
+SELECT id, group_id, TRUE, 100, 1, 30
+FROM api_keys
+WHERE deleted_at IS NULL AND group_id IS NOT NULL
+ON CONFLICT (api_key_id, group_id) DO NOTHING;
