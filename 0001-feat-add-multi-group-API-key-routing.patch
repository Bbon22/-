+// ReplaceRoutes atomically replaces a key's route set and updates the legacy
+// group_id projection to its first enabled route.
+func (r *apiKeyRepository) ReplaceRoutes(ctx context.Context, apiKeyID int64, enabled bool, routes []service.APIKeyRoute) error {
+	if r.sql == nil {
+		return errors.New("api key routing database is unavailable")
+	}
+	var primary int64
+	bestPriority := int(^uint(0) >> 1)
+	for _, route := range routes {
+		if route.Enabled && (primary == 0 || route.Priority < bestPriority) {
+			primary = route.GroupID
+			bestPriority = route.Priority
+		}
+	}
+	if primary == 0 && len(routes) > 0 {
+		primary = routes[0].GroupID
+	}
+
+	exec := clientFromContext(ctx, r.client)
+	var tx *dbent.Tx
+	var err error
+	if dbent.TxFromContext(ctx) == nil {
+		tx, err = r.client.Tx(ctx)
+		if err != nil {
+			return err
+		}
+		defer func() { _ = tx.Rollback() }()
+		exec = tx.Client()
+	}
+	if _, err := exec.ExecContext(ctx, `DELETE FROM api_key_routes WHERE api_key_id = $1`, apiKeyID); err != nil {
+		return err
+	}
+	for _, route := range routes {
+		if _, err := exec.ExecContext(ctx, `
+			INSERT INTO api_key_routes (api_key_id, group_id, enabled, priority, weight, cooldown_seconds)
+			VALUES ($1, $2, $3, $4, $5, $6)`, apiKeyID, route.GroupID, route.Enabled, route.Priority, route.Weight, route.CooldownSeconds); err != nil {
+			return err
+		}
+	}
+	if primary == 0 {
+		if _, err := exec.ExecContext(ctx, `UPDATE api_keys SET multi_group_routing_enabled = $1, group_id = NULL, updated_at = NOW() WHERE id = $2 AND deleted_at IS NULL`, enabled, apiKeyID); err != nil {
+			return err
+		}
+	} else if _, err := exec.ExecContext(ctx, `UPDATE api_keys SET multi_group_routing_enabled = $1, group_id = $2, updated_at = NOW() WHERE id = $3 AND deleted_at IS NULL`, enabled, primary, apiKeyID); err != nil {
+		return err
+	}
+	if tx != nil {
+		return tx.Commit()
+	}
+	return nil
+}
