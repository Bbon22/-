diff --git a/backend/internal/repository/api_key_route_cooldown_test.go b/backend/internal/repository/api_key_route_cooldown_test.go
new file mode 100644
index 000000000..3a67e5454
--- /dev/null
+++ b/backend/internal/repository/api_key_route_cooldown_test.go
@@ -0,0 +1,60 @@
+package repository
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAPIKeyRouteCooldownIsolatedByKeyAndGroupAndExpires(t *testing.T) {
+	server := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	defer func() { _ = client.Close() }()
+	cache := &apiKeyCache{rdb: client}
+	ctx := context.Background()
+
+	require.NoError(t, cache.SetAPIKeyRouteCooldown(ctx, 11, 7, 30))
+	cooling, err := cache.IsAPIKeyRouteCooling(ctx, 11, 7)
+	require.NoError(t, err)
+	require.True(t, cooling)
+
+	// A different group and a different key must not inherit this cooldown.
+	cooling, err = cache.IsAPIKeyRouteCooling(ctx, 11, 8)
+	require.NoError(t, err)
+	require.False(t, cooling)
+	cooling, err = cache.IsAPIKeyRouteCooling(ctx, 12, 7)
+	require.NoError(t, err)
+	require.False(t, cooling)
+
+	server.FastForward(31 * time.Second)
+	cooling, err = cache.IsAPIKeyRouteCooling(ctx, 11, 7)
+	require.NoError(t, err)
+	require.False(t, cooling)
+}
+
+func TestAPIKeyRouteCooldownCanBeClearedIndividuallyOrForKey(t *testing.T) {
+	server := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	defer func() { _ = client.Close() }()
+	cache := &apiKeyCache{rdb: client}
+	ctx := context.Background()
+
+	require.NoError(t, cache.SetAPIKeyRouteCooldown(ctx, 21, 1, 30))
+	require.NoError(t, cache.SetAPIKeyRouteCooldown(ctx, 21, 2, 30))
+	require.NoError(t, cache.ClearAPIKeyRouteCooldown(ctx, 21, 1))
+	cooling, err := cache.IsAPIKeyRouteCooling(ctx, 21, 1)
+	require.NoError(t, err)
+	require.False(t, cooling)
+	cooling, err = cache.IsAPIKeyRouteCooling(ctx, 21, 2)
+	require.NoError(t, err)
+	require.True(t, cooling)
+
+	require.NoError(t, cache.ClearAPIKeyRouteCooldowns(ctx, 21))
+	cooling, err = cache.IsAPIKeyRouteCooling(ctx, 21, 2)
+	require.NoError(t, err)
+	require.False(t, cooling)
+}
