+// routingInflightReservationState keeps enough information to re-price the
+// in-flight balance hold when a multi-group key fails over to another group.
+// It is stored in the request context so all gateway variants share one
+// billing lifecycle implementation.
+type routingInflightReservationState struct {
+	billing   *service.BillingCacheService
+	estimator inflightReservationEstimator
+	req       service.InflightEstimateRequest
+	release   func()
+}
+
+type routingInflightReservationContextKey struct{}
+
+func withRoutingInflightReservationState(ctx context.Context, state *routingInflightReservationState) context.Context {
+	if state == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, routingInflightReservationContextKey{}, state)
