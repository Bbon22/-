+// ListRoutes reads route candidates in stable priority order. The method is
+// intentionally outside the Ent API so it remains usable during a rolling
+// upgrade where the route table may not yet exist on an older database.
+func (r *apiKeyRepository) ListRoutes(ctx context.Context, apiKeyID int64) ([]service.APIKeyRoute, error) {
+	if r.sql == nil {
+		return nil, nil
+	}
+	rows, err := r.sql.QueryContext(ctx, `
+		SELECT group_id, enabled, priority, weight, cooldown_seconds
+		FROM api_key_routes
+		WHERE api_key_id = $1
+		ORDER BY priority ASC, id ASC`, apiKeyID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var routes []service.APIKeyRoute
+	for rows.Next() {
+		var route service.APIKeyRoute
+		if err := rows.Scan(&route.GroupID, &route.Enabled, &route.Priority, &route.Weight, &route.CooldownSeconds); err != nil {
+			return nil, err
+		}
+		routes = append(routes, route)
+	}
+	return routes, rows.Err()
+}
+
+func (r *apiKeyRepository) GetRoutingEnabled(ctx context.Context, apiKeyID int64) (bool, error) {
+	if r.sql == nil {
+		return false, nil
+	}
+	rows, err := r.sql.QueryContext(ctx, `SELECT multi_group_routing_enabled FROM api_keys WHERE id = $1 AND deleted_at IS NULL`, apiKeyID)
+	if err != nil {
+		return false, err
+	}
+	defer rows.Close()
+	if !rows.Next() {
+		return false, nil
+	}
+	var enabled bool
+	if err := rows.Scan(&enabled); err != nil {
+		return false, err
+	}
+	return enabled, rows.Err()
+}
