+func (c *apiKeyCache) IsAPIKeyRouteCooling(ctx context.Context, apiKeyID, groupID int64) (bool, error) {
+	n, err := c.rdb.Exists(ctx, apiKeyRouteCooldownKey(apiKeyID, groupID)).Result()
+	return n > 0, err
+}
+
+func (c *apiKeyCache) SetAPIKeyRouteCooldown(ctx context.Context, apiKeyID, groupID int64, seconds int) error {
+	key := apiKeyRouteCooldownKey(apiKeyID, groupID)
+	if seconds <= 0 {
+		return c.rdb.Del(ctx, key).Err()
+	}
+	return c.rdb.Set(ctx, key, "1", time.Duration(seconds)*time.Second).Err()
+}
+
+func (c *apiKeyCache) ClearAPIKeyRouteCooldown(ctx context.Context, apiKeyID, groupID int64) error {
+	return c.rdb.Del(ctx, apiKeyRouteCooldownKey(apiKeyID, groupID)).Err()
+}
+
+func (c *apiKeyCache) ClearAPIKeyRouteCooldowns(ctx context.Context, apiKeyID int64) error {
+	pattern := fmt.Sprintf("%s%d:*", apiKeyRouteCooldownPrefix, apiKeyID)
+	var cursor uint64
+	for {
+		keys, next, err := c.rdb.Scan(ctx, cursor, pattern, 100).Result()
+		if err != nil {
+			return err
+		}
+		if len(keys) > 0 {
+			if err := c.rdb.Del(ctx, keys...).Err(); err != nil {
+				return err
+			}
+		}
+		cursor = next
+		if cursor == 0 {
+			return nil
+		}
+	}
+}
