--- /dev/null
+++ b/backend/internal/handler/grok_audio_test.go
@@ -0,0 +1,24 @@
+package handler
+
+import (
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+func TestGrokVoiceAllowsAPIKeyRouteFailoverOnlyForTTSAndSTT(t *testing.T) {
+	key := &service.APIKey{MultiGroupRoutingEnabled: true}
+	for _, endpoint := range []string{"tts", "stt"} {
+		if !grokVoiceAllowsAPIKeyRouteFailover(key, endpoint) {
+			t.Errorf("group failover should be allowed for %q", endpoint)
+		}
+	}
+	for _, endpoint := range []string{"custom-voices", "custom-voices/voice-1", "realtime"} {
+		if grokVoiceAllowsAPIKeyRouteFailover(key, endpoint) {
+			t.Errorf("group failover should be disabled for %q", endpoint)
+		}
+	}
+	if grokVoiceAllowsAPIKeyRouteFailover(&service.APIKey{}, "tts") {
+		t.Fatal("group failover should respect the API key routing switch")
+	}
+}
