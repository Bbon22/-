+func (r *apiKeyRepository) SetRoutingEnabled(ctx context.Context, apiKeyID int64, enabled bool) error {
+	if r.sql == nil {
+		return errors.New("api key routing database is unavailable")
+	}
+	_, err := r.sql.ExecContext(ctx, `UPDATE api_keys SET multi_group_routing_enabled = $1, updated_at = NOW() WHERE id = $2 AND deleted_at IS NULL`, enabled, apiKeyID)
+	return err
+}
