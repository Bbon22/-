+func TestIsAPIKeyRouteRetryableErrorUsesFailureClass(t *testing.T) {
+	tests := []struct {
+		name string
+		err  *UpstreamFailoverError
+		want bool
+	}{
+		{name: "connection failure", err: &UpstreamFailoverError{StatusCode: 0}, want: true},
+		{name: "request timeout", err: &UpstreamFailoverError{StatusCode: 408}, want: true},
+		{name: "rate limited", err: &UpstreamFailoverError{StatusCode: 429}, want: true},
+		{name: "server failure", err: &UpstreamFailoverError{StatusCode: 503}, want: true},
+		{name: "client request error", err: &UpstreamFailoverError{StatusCode: 400}, want: false},
+		{name: "credential failure", err: &UpstreamFailoverError{StatusCode: 503, Stage: GatewayFailureStageAccountAuth}, want: false},
+		{name: "request scoped", err: &UpstreamFailoverError{StatusCode: 503, Scope: GatewayFailureScopeRequest}, want: false},
+		{name: "provider scoped", err: &UpstreamFailoverError{StatusCode: 503, Scope: GatewayFailureScopeProvider}, want: false},
+		{name: "request transient", err: &UpstreamFailoverError{StatusCode: 503, RequestScopedTransient: true}, want: false},
+		{name: "explicit stop", err: &UpstreamFailoverError{StatusCode: 503, NextAccountAction: NextAccountStop}, want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := IsAPIKeyRouteRetryableError(tt.err); got != tt.want {
+				t.Fatalf("IsAPIKeyRouteRetryableError() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
