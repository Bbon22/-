+// GetRouting returns the atomic routing configuration for an API key.
+func (h *APIKeyHandler) GetRouting(c *gin.Context) {
+	subject, ok := middleware2.GetAuthSubjectFromContext(c)
+	if !ok {
+		response.Unauthorized(c, "User not authenticated")
+		return
+	}
+	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil {
+		response.BadRequest(c, "Invalid key ID")
+		return
+	}
+	enabled, routes, err := h.apiKeyService.GetRouting(c.Request.Context(), id, subject.UserID)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, gin.H{"enabled": enabled, "routes": routes})
+}
+
+// UpdateRouting replaces all routes in one transaction and clears their cooldowns.
+func (h *APIKeyHandler) UpdateRouting(c *gin.Context) {
+	subject, ok := middleware2.GetAuthSubjectFromContext(c)
+	if !ok {
+		response.Unauthorized(c, "User not authenticated")
+		return
+	}
+	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil {
+		response.BadRequest(c, "Invalid key ID")
+		return
+	}
+	var req APIKeyRoutingRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		response.BadRequest(c, "Invalid routing request: "+err.Error())
+		return
+	}
+	if err := h.apiKeyService.UpdateRouting(c.Request.Context(), id, subject.UserID, req.Enabled, req.Routes); err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	enabled, routes, err := h.apiKeyService.GetRouting(c.Request.Context(), id, subject.UserID)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, gin.H{"enabled": enabled, "routes": routes})
+}
+
