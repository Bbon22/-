+	middleware2 "github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+func resolveAPIKeyRoutingGroup(c *gin.Context, apiKeyService *service.APIKeyService, key *service.APIKey, excluded map[int64]struct{}) (bool, *service.UserSubscription, error) {
+	if key == nil || !key.MultiGroupRoutingEnabled {
+		return false, nil, nil
+	}
+	if len(excluded) == 0 {
+		return false, nil, nil
+	}
+	previousGroupID := int64(0)
+	if key.GroupID != nil {
+		previousGroupID = *key.GroupID
+	}
+	if err := apiKeyService.ResolveRoutingGroupExcluding(c.Request.Context(), key, excluded); err != nil {
+		return false, nil, err
+	}
+	if key.GroupID == nil || key.Group == nil {
+		return false, nil, service.ErrAPIKeyRoutingUnavailable
+	}
+	if previousGroupID == *key.GroupID {
+		return false, nil, nil
+	}
+
+	ctx := context.WithValue(c.Request.Context(), ctxkey.Group, key.Group)
+	c.Request = c.Request.WithContext(ctx)
+	c.Set(string(middleware2.ContextKeyAPIKey), key)
+	subscription, err := apiKeyService.GetRoutingSubscription(c.Request.Context(), key)
+	if err != nil {
+		return false, nil, err
+	}
+	if subscription == nil {
+		c.Set(string(middleware2.ContextKeySubscription), (*service.UserSubscription)(nil))
+	} else {
+		c.Set(string(middleware2.ContextKeySubscription), subscription)
+	}
+	return true, subscription, nil
+}
+
+func checkRoutingGroupBilling(c *gin.Context, billing *service.BillingCacheService, key *service.APIKey, subscription *service.UserSubscription) error {
+	if billing != nil && key != nil {
+		if err := billing.CheckBillingEligibility(c.Request.Context(), key.User, key, key.Group, subscription, service.QuotaPlatform(c.Request.Context(), key)); err != nil {
+			return err
+		}
+	}
+	return refreshRoutingInflightReservation(c, key, subscription)
+}
