+// refreshRoutingInflightReservation rebinds the handler's balance hold to the
+// newly selected group. It is a no-op for requests that did not create a hold.
+func refreshRoutingInflightReservation(c *gin.Context, key *service.APIKey, subscription *service.UserSubscription) error {
+	if c == nil || c.Request == nil {
+		return nil
+	}
+	state, _ := c.Request.Context().Value(routingInflightReservationContextKey{}).(*routingInflightReservationState)
+	if state == nil {
+		return nil
+	}
+	if state.release != nil {
+		state.release()
+	}
+	state.release = nil
+	baseCtx := service.WithoutInflightReservation(c.Request.Context())
+	ctx, done, err := reserveInflightBalanceCtx(baseCtx, state.billing, state.estimator, key, subscription, state.req)
+	if err != nil {
+		return err
+	}
+	state.release = done
+	ctx = withRoutingInflightReservationState(ctx, state)
+	c.Request = c.Request.WithContext(ctx)
+	return nil
+}
