diff --git a/backend/internal/service/api_key_routing.go b/backend/internal/service/api_key_routing.go
new file mode 100644
index 000000000..e025c1895
--- /dev/null
+++ b/backend/internal/service/api_key_routing.go
@@ -0,0 +1,339 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math/rand"
+
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+)
+
+var ErrAPIKeyRoutingUnavailable = errors.New("api key has no available routing group")
+
+const maxAPIKeyRouteValue = int(1<<31 - 1)
+
+// APIKeyRoutingRepository is optional so existing lightweight API key test
+// doubles and rolling upgrades continue to work while the route table is new.
+type APIKeyRoutingRepository interface {
+	ListRoutes(ctx context.Context, apiKeyID int64) ([]APIKeyRoute, error)
+	ReplaceRoutes(ctx context.Context, apiKeyID int64, enabled bool, routes []APIKeyRoute) error
+	GetRoutingEnabled(ctx context.Context, apiKeyID int64) (bool, error)
+	SetRoutingEnabled(ctx context.Context, apiKeyID int64, enabled bool) error
+}
+
+// APIKeyRouteCooldownCache is implemented by the Redis API key cache. It is
+// deliberately optional: a Redis outage must not make legacy single-group
+// keys fail authentication.
+type APIKeyRouteCooldownCache interface {
+	IsAPIKeyRouteCooling(ctx context.Context, apiKeyID, groupID int64) (bool, error)
+	SetAPIKeyRouteCooldown(ctx context.Context, apiKeyID, groupID int64, seconds int) error
+	ClearAPIKeyRouteCooldown(ctx context.Context, apiKeyID, groupID int64) error
+	ClearAPIKeyRouteCooldowns(ctx context.Context, apiKeyID int64) error
+}
+
+func normalizeAPIKeyRoutes(routes []APIKeyRoute) []APIKeyRoute {
+	out := make([]APIKeyRoute, len(routes))
+	copy(out, routes)
+	for i := range out {
+		out[i] = out[i].normalized()
+	}
+	return out
+}
+
+func validateAPIKeyRoutes(routes []APIKeyRoute) error {
+	if len(routes) == 0 {
+		return fmt.Errorf("at least one route is required")
+	}
+	if len(routes) > 1000 {
+		return fmt.Errorf("at most 1000 routes are allowed")
+	}
+	seen := make(map[int64]struct{}, len(routes))
+	enabled := 0
+	for _, route := range routes {
+		if route.GroupID <= 0 {
+			return fmt.Errorf("route group_id must be positive")
+		}
+		if route.Priority < 0 || route.Priority > maxAPIKeyRouteValue {
+			return fmt.Errorf("route priority must be between 0 and %d", maxAPIKeyRouteValue)
+		}
+		if route.Weight < 1 || route.Weight > maxAPIKeyRouteValue {
+			return fmt.Errorf("route weight must be between 1 and %d", maxAPIKeyRouteValue)
+		}
+		if route.CooldownSeconds < 1 || route.CooldownSeconds > maxAPIKeyRouteValue {
+			return fmt.Errorf("route cooldown_seconds must be between 1 and %d", maxAPIKeyRouteValue)
+		}
+		if _, ok := seen[route.GroupID]; ok {
+			return fmt.Errorf("route group_id %d is duplicated", route.GroupID)
+		}
+		seen[route.GroupID] = struct{}{}
+		if route.Enabled {
+			enabled++
+		}
+	}
+	if enabled == 0 {
+		return fmt.Errorf("at least one route must be enabled")
+	}
+	return nil
+}
+
+func apiKeyRoutingGroupsCompatible(left, right *Group) bool {
+	return left != nil && right != nil &&
+		left.Platform == right.Platform &&
+		left.SubscriptionType == right.SubscriptionType
+}
+
+// SelectAPIKeyRoute implements the priority-then-weight rule. The caller
+// supplies the cooldown set so this function is deterministic and easy to test.
+func SelectAPIKeyRoute(routes []APIKeyRoute, cooling map[int64]bool) (APIKeyRoute, bool) {
+	return selectAPIKeyRouteWithDraw(routes, cooling, func(total int64) int64 {
+		return rand.Int63n(total)
+	})
+}
+
+func selectAPIKeyRouteWithDraw(routes []APIKeyRoute, cooling map[int64]bool, draw func(int64) int64) (APIKeyRoute, bool) {
+	bestPriority := 0
+	found := false
+	for _, route := range routes {
+		if !route.Enabled || cooling[route.GroupID] {
+			continue
+		}
+		route = route.normalized()
+		if !found || route.Priority < bestPriority {
+			bestPriority = route.Priority
+			found = true
+		}
+	}
+	if !found {
+		return APIKeyRoute{}, false
+	}
+	eligible := make([]APIKeyRoute, 0, len(routes))
+	total := int64(0)
+	for _, route := range routes {
+		if route.Enabled && !cooling[route.GroupID] && route.Priority == bestPriority {
+			route = route.normalized()
+			eligible = append(eligible, route)
+			total += int64(route.Weight)
+		}
+	}
+	if total <= 0 {
+		return APIKeyRoute{}, false
+	}
+	point := draw(total)
+	for _, route := range eligible {
+		if point < int64(route.Weight) {
+			return route, true
+		}
+		point -= int64(route.Weight)
+	}
+	return eligible[len(eligible)-1], true
+}
+
+func (s *APIKeyService) GetRouting(ctx context.Context, id, userID int64) (bool, []APIKeyRoute, error) {
+	key, err := s.apiKeyRepo.GetByID(ctx, id)
+	if err != nil {
+		return false, nil, err
+	}
+	if key.UserID != userID {
+		return false, nil, ErrInsufficientPerms
+	}
+	if repo, ok := s.apiKeyRepo.(APIKeyRoutingRepository); ok {
+		routes, err := repo.ListRoutes(ctx, id)
+		if err != nil {
+			return false, nil, fmt.Errorf("list api key routes: %w", err)
+		}
+		if len(routes) > 0 {
+			return key.MultiGroupRoutingEnabled, normalizeAPIKeyRoutes(routes), nil
+		}
+	}
+	if key.GroupID == nil {
+		return key.MultiGroupRoutingEnabled, []APIKeyRoute{}, nil
+	}
+	return key.MultiGroupRoutingEnabled, []APIKeyRoute{{GroupID: *key.GroupID, Enabled: true, Priority: 100, Weight: 1, CooldownSeconds: 30}}, nil
+}
+
+func (s *APIKeyService) UpdateRouting(ctx context.Context, id, userID int64, enabled bool, routes []APIKeyRoute) error {
+	key, err := s.apiKeyRepo.GetByID(ctx, id)
+	if err != nil {
+		return err
+	}
+	if key.UserID != userID {
+		return ErrInsufficientPerms
+	}
+	if err := validateAPIKeyRoutes(routes); err != nil {
+		return infraerrors.BadRequest("API_KEY_ROUTES_INVALID", err.Error())
+	}
+	user, err := s.userRepo.GetByID(ctx, userID)
+	if err != nil {
+		return err
+	}
+	var routingGroup *Group
+	if key.Group != nil {
+		routingGroup = key.Group
+	}
+	for _, route := range routes {
+		group, err := s.groupRepo.GetByID(ctx, route.GroupID)
+		if err != nil {
+			return err
+		}
+		if group == nil {
+			return infraerrors.BadRequest("API_KEY_ROUTES_INCOMPATIBLE", "routing group does not exist")
+		}
+		if routingGroup != nil && !apiKeyRoutingGroupsCompatible(routingGroup, group) {
+			return infraerrors.BadRequest("API_KEY_ROUTES_INCOMPATIBLE", "routing groups must use the same platform and subscription type")
+		}
+		if routingGroup == nil {
+			routingGroup = group
+		}
+		if !s.canUserBindGroup(ctx, user, group) {
+			return ErrGroupNotAllowed
+		}
+	}
+	repo, ok := s.apiKeyRepo.(APIKeyRoutingRepository)
+	if !ok {
+		return fmt.Errorf("api key routing is not supported by this repository")
+	}
+	routes = normalizeAPIKeyRoutes(routes)
+	if err := repo.ReplaceRoutes(ctx, id, enabled, routes); err != nil {
+		return fmt.Errorf("save api key routes: %w", err)
+	}
+	if cache, ok := s.cache.(APIKeyRouteCooldownCache); ok {
+		_ = cache.ClearAPIKeyRouteCooldowns(ctx, id)
+	}
+	s.InvalidateAuthCacheByKey(ctx, key.Key)
+	return nil
+}
+
+func (s *APIKeyService) GetRoutingSubscription(ctx context.Context, key *APIKey) (*UserSubscription, error) {
+	if key == nil || key.Group == nil || !key.Group.IsSubscriptionType() {
+		return nil, nil
+	}
+	if s.userSubRepo == nil || key.UserID <= 0 || key.Group.ID <= 0 {
+		return nil, ErrSubscriptionNotFound
+	}
+	return s.userSubRepo.GetActiveByUserIDAndGroupID(ctx, key.UserID, key.Group.ID)
+}
+
+// ResolveRoutingGroup chooses the current group for an authenticated request.
+// It returns the legacy binding unchanged when the feature is disabled.
+func (s *APIKeyService) ResolveRoutingGroup(ctx context.Context, key *APIKey) error {
+	return s.ResolveRoutingGroupExcluding(ctx, key, nil)
+}
+
+func (s *APIKeyService) ResolveRoutingGroupExcluding(ctx context.Context, key *APIKey, excluded map[int64]struct{}) error {
+	if key == nil || !key.MultiGroupRoutingEnabled {
+		return nil
+	}
+	routes, err := s.routesForKey(ctx, key)
+	if err != nil {
+		return err
+	}
+	cooling := make(map[int64]bool, len(routes))
+	if cache, ok := s.cache.(APIKeyRouteCooldownCache); ok {
+		for _, route := range routes {
+			if !route.Enabled {
+				continue
+			}
+			cooling[route.GroupID], _ = cache.IsAPIKeyRouteCooling(ctx, key.ID, route.GroupID)
+		}
+	}
+	available := make([]APIKeyRoute, 0, len(routes))
+	for _, route := range routes {
+		if _, skip := excluded[route.GroupID]; skip || !route.Enabled || cooling[route.GroupID] {
+			continue
+		}
+		group, groupErr := s.groupRepo.GetByID(ctx, route.GroupID)
+		if groupErr != nil || group == nil || !group.IsActive() || key.User == nil || !s.canUserBindGroup(ctx, key.User, group) {
+			continue
+		}
+		if key.Group != nil && !apiKeyRoutingGroupsCompatible(key.Group, group) {
+			continue
+		}
+		available = append(available, route)
+	}
+	selected, ok := SelectAPIKeyRoute(available, nil)
+	if !ok {
+		return ErrAPIKeyRoutingUnavailable
+	}
+	group, err := s.groupRepo.GetByID(ctx, selected.GroupID)
+	if err != nil {
+		return err
+	}
+	key.GroupID = &selected.GroupID
+	key.Group = group
+	key.Routes = routes
+	return nil
+}
+
+func (s *APIKeyService) routesForKey(ctx context.Context, key *APIKey) ([]APIKeyRoute, error) {
+	if repo, ok := s.apiKeyRepo.(APIKeyRoutingRepository); ok {
+		routes, err := repo.ListRoutes(ctx, key.ID)
+		if err != nil {
+			return nil, err
+		}
+		if len(routes) > 0 {
+			return normalizeAPIKeyRoutes(routes), nil
+		}
+	}
+	if key.GroupID == nil {
+		return nil, nil
+	}
+	return []APIKeyRoute{{GroupID: *key.GroupID, Enabled: true, Priority: 100, Weight: 1, CooldownSeconds: 30}}, nil
+}
+
+func (s *APIKeyService) MarkRoutingFailure(ctx context.Context, keyID, groupID int64, routeErr error) {
+	if keyID <= 0 || groupID <= 0 || !IsAPIKeyRouteRetryableError(routeErr) {
+		return
+	}
+	routes, err := s.routesForKey(ctx, &APIKey{ID: keyID})
+	if err != nil {
+		return
+	}
+	for _, route := range routes {
+		if route.GroupID == groupID && route.Enabled {
+			if cache, ok := s.cache.(APIKeyRouteCooldownCache); ok {
+				_ = cache.SetAPIKeyRouteCooldown(ctx, keyID, groupID, route.CooldownSeconds)
+			}
+			return
+		}
+	}
+}
+
+func (s *APIKeyService) MarkRoutingUnavailable(ctx context.Context, key *APIKey, groupID int64) {
+	if key == nil || !key.MultiGroupRoutingEnabled {
+		return
+	}
+	routes, err := s.routesForKey(ctx, key)
+	if err != nil {
+		return
+	}
+	for _, route := range routes {
+		if route.GroupID == groupID && route.Enabled {
+			if cache, ok := s.cache.(APIKeyRouteCooldownCache); ok {
+				_ = cache.SetAPIKeyRouteCooldown(ctx, key.ID, groupID, route.CooldownSeconds)
+			}
+			return
+		}
+	}
+}
+
+func IsAPIKeyRouteRetryableError(err error) bool {
+	if err == nil {
+		return false
+	}
+	var failover *UpstreamFailoverError
+	if errors.As(err, &failover) {
+		if !failover.ShouldRetryNextAccount() || failover.IsCredentialFailure() ||
+			failover.RequestScopedTransient || failover.Scope == GatewayFailureScopeRequest || failover.Scope == GatewayFailureScopeProvider {
+			return false
+		}
+		return failover.StatusCode == 0 || failover.StatusCode == 408 || failover.StatusCode == 429 || failover.StatusCode >= 500
+	}
+	return false
+}
+
+func (s *APIKeyService) ClearRoutingCooldown(ctx context.Context, keyID, groupID int64) {
+	if cache, ok := s.cache.(APIKeyRouteCooldownCache); ok {
+		_ = cache.ClearAPIKeyRouteCooldown(ctx, keyID, groupID)
+	}
+}
