+package schema
+
+import (
+	"entgo.io/ent"
+	"entgo.io/ent/dialect/entsql"
+	"entgo.io/ent/schema"
+	"entgo.io/ent/schema/edge"
+	"entgo.io/ent/schema/field"
+	"entgo.io/ent/schema/index"
+)
+
+// APIKeyRoute stores the ordered group candidates attached to one API key.
+// The legacy api_keys.group_id column remains the compatibility projection.
+type APIKeyRoute struct {
+	ent.Schema
+}
+
+func (APIKeyRoute) Annotations() []schema.Annotation {
+	return []schema.Annotation{entsql.Annotation{Table: "api_key_routes"}}
+}
+
+func (APIKeyRoute) Fields() []ent.Field {
+	return []ent.Field{
+		field.Int64("api_key_id"),
+		field.Int64("group_id"),
+		field.Bool("enabled").Default(true),
+		field.Int("priority").Default(100),
+		field.Int("weight").Default(1),
+		field.Int("cooldown_seconds").Default(30),
+	}
+}
+
+func (APIKeyRoute) Edges() []ent.Edge {
+	return []ent.Edge{
+		edge.From("api_key", APIKey.Type).Ref("routes").Field("api_key_id").Unique().Required(),
+		edge.From("group", Group.Type).Ref("api_key_routes").Field("group_id").Unique().Required(),
+	}
+}
+
+func (APIKeyRoute) Indexes() []ent.Index {
+	return []ent.Index{
+		index.Fields("api_key_id", "group_id").Unique(),
+		index.Fields("api_key_id", "enabled", "priority"),
+	}
+}
